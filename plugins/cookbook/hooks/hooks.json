{
  "description": "Cookbook: at session start, says when a daily update report is waiting; at a turn's end, stops once a closing message that leaves an owner question unasked or a finished T3 chat unsettled (recipes/owner-questions.md).",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/stack-updates-notice.mjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"C:/Program Files/nodejs/node.exe\" \"${CLAUDE_PLUGIN_ROOT}/hooks/owner-questions.mjs\"",
            "timeout": 20
          }
        ]
      }
    ]
  }
}
