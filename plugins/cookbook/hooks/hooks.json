{
  "description": "Cookbook: at session start, says when a daily update report is waiting (reads ~/.local/share/stack-updates only); at session start, on a prompt and after a tool, says which model the usage budget asks for (reads the Claude usage at a session start, at most once per ten minutes, and the reading T3 Code saves when that read is refused; writes ~/.local/share/model-budget only); at a turn's end, stops once a closing message that leaves an owner question unasked or a finished T3 chat unsettled (recipes/owner-questions.md).",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/stack-updates-notice.mjs\"",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/model-budget-note.mjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/model-budget-note.mjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/model-budget-note.mjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"C:/Program Files/nodejs/node.exe\" \"${CLAUDE_PLUGIN_ROOT}/hooks/owner-questions.mjs\"",
            "timeout": 20
          }
        ]
      }
    ]
  }
}
